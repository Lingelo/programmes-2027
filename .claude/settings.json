{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hook-check-data.mjs\" post",
            "timeout": 30,
            "statusMessage": "Vérification des données…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hook-check-data.mjs\" pre",
            "timeout": 60,
            "statusMessage": "Vérification des données avant commit…"
          }
        ]
      }
    ]
  }
}
